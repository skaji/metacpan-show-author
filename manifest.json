{
  "manifest_version": 3,
  "name": "metacpan-show-author",
  "description": "Show authors in MetaCPAN recent page",
  "version": "0.0.3",
  "content_scripts": [
    {
      "matches": [
        "https://metacpan.org/recent*",
        "https://metacpan.org/requires/module*",
        "https://metacpan.org/requires/distribution*"
      ],
      "js": ["myscript.js"],
      "run_at": "document_end"
    }
  ]
}
